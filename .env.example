# Cloudflare Workers AI — motor de tutoría textual y transcripción de notas de voz.
# Para coste cero, la cuenta debe permanecer en Workers Free:
# 10.000 Neurons gratuitos al día; al agotarse, Orby se detiene sin fallback.
# Crear un token limitado a Workers AI Read + Edit. No guardar valores reales aquí.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Voz femenina usada por Gemini Live en el modo de conversación por voz.
# Opciones permitidas: Despina (recomendada), Aoede, Sulafat, Achird, Leda, Kore, Zephyr.
# Habilita Live/TTS/visión de Gemini en producción solo tras aprobar privacidad.
# El nivel gratuito de Google puede usar audio, imágenes y texto para mejorar productos.
# Mantener false/no definido hasta contar con consentimiento y aprobación de tratamiento.
ORBY_GEMINI_LIVE_ENABLED=false
# Voz femenina usada por Gemini Live y el TTS de respaldo.
ORBY_LIVE_VOICE_NAME=Despina
