# Coste cero: estas confirmaciones son obligatorias para habilitar inferencia.
# El servidor NO puede consultar automáticamente el plan comercial de cada cuenta.
# Verifica cada consola y deja false si no puedes confirmar que la cuenta sigue en el plan sin coste.
# Nunca pongas true solo porque exista una API key o porque un modelo tenga una cuota gratuita documentada.
PEAKSCORE_CLOUDFLARE_FREE_TIER_CONFIRMED=false
PEAKSCORE_GEMINI_FREE_TIER_CONFIRMED=false
PEAKSCORE_GEMINI_DATA_USE_APPROVED=false
PEAKSCORE_GROQ_FREE_TIER_CONFIRMED=false
PEAKSCORE_LLM7_FREE_TIER_CONFIRMED=false

# Cloudflare Workers AI — motor de tutoría textual y transcripción de notas de voz.
# Para coste cero, la cuenta debe permanecer en el plan Workers Free y sin facturación Paid:
# 10.000 Neurons gratuitos al día para la cuenta; al agotarse, Orby se detiene sin fallback.
# El código no puede impedir cargos si la cuenta se cambia a Workers Paid.
# Crear un token limitado a Workers AI Read + Edit. No guardar valores reales aquí.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Gemini Live y análisis visual de Gemini en producción requieren aprobación de privacidad.
# El nivel gratuito de Google puede usar el contenido enviado para mejorar sus productos.
# Mantener false/no definido hasta contar con consentimiento y aprobación de tratamiento.
ORBY_GEMINI_LIVE_ENABLED=false
# Voz femenina usada por Gemini Live y por el endpoint alternativo Gemini TTS.
# Opciones de voz Live admitidas por la configuración del proyecto: Despina, Aoede, Sulafat, Achird, Leda, Kore, Zephyr.
ORBY_LIVE_VOICE_NAME=Despina

# El respaldo de voz actual usa Gemini TTS con GEMINI_API_KEY (cuota gratuita sujeta al plan y región).
# En producción comparte el opt-in de privacidad ORBY_GEMINI_LIVE_ENABLED.
# Si Gemini TTS no está disponible o agota su cuota, la respuesta queda visible por escrito;
# no se activa Cloudflare TTS ni ningún proveedor de pago.
