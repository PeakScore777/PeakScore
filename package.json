{
  "name": "peakscore",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm test && npm run lint && next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "prepare": "husky",
    "test:orby": "node --test tests/orby-request-filter.test.mjs",
    "test": "npm run test:orby && npm run test:monitor-projection && npm run test:monitor-camera-fit && npm run test:archivo-3d-text && npm run test:archivo-oculto-contract && npm run test:community-role-privacy && npm run test:community-live-security && npm run test:upload-security && npm run test:github-actions-pinning && npm run test:community-message-metrics && npm run test:community-comments-pagination && npm run test:community-discord-layout && npm run test:community-chat-contract && npm run test:community-founder-authority && npm run test:community-profile-banner && npm run test:peakstyle && npm run test:community-profile-studio && npm run test:community-founder-studio && npm run test:community-spaces && npm run test:community-live-spaces && npm run test:community-premium-features",
    "test:monitor-projection": "node --test tests/monitor-projective-quad.test.mjs",
    "test:archivo-3d-text": "node --test tests/archivo-oculto-no-external-text-fonts.test.mjs",
    "test:monitor-camera-fit": "node --test tests/monitor-camera-fit.test.mjs",
    "test:archivo-oculto-contract": "node --test tests/archivo-oculto-completion-contract.test.mjs",
    "test:community-role-privacy": "node --test tests/community-role-privacy-contract.test.mjs",
    "test:community-live-security": "node --test tests/community-live-security-contract.test.mjs",
    "test:upload-security": "node --test tests/upload-security-contract.test.mjs",
    "test:github-actions-pinning": "node --test tests/github-actions-pinning.test.mjs",
    "test:community-message-metrics": "node --test tests/community-message-metrics-contract.test.mjs",
    "test:community-comments-pagination": "node --test tests/community-comments-pagination-contract.test.mjs",
    "test:community-discord-layout": "node --test tests/community-discord-layout-contract.test.mjs",
    "test:community-chat-contract": "node --test tests/community-chat-contract.test.mjs",
    "test:community-founder-authority": "node --test tests/community-founder-authority-contract.test.mjs",
    "test:community-profile-banner": "node --test tests/community-profile-banner-contract.test.mjs",
    "test:peakstyle": "node --test tests/peakstyle-cosmetics-contract.test.mjs",
    "test:community-profile-studio": "node --test tests/community-profile-studio-contract.test.mjs",
    "dev:clean": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\" && next dev",
    "test:community-founder-studio": "node --test tests/community-founder-studio-contract.test.mjs",
    "test:community-spaces": "node --test tests/community-spaces-isolation-contract.test.mjs",
    "test:community-live-spaces": "node --test tests/community-live-space-scope-contract.test.mjs",
    "test:community-premium-features": "node --test tests/community-premium-features-contract.test.mjs"
  },
  "dependencies": {
    "@cos-design/photo-clothesline": "^3.7.4",
    "@google/genai": "^2.17.1",
    "@marsidev/react-turnstile": "^1.6.1",
    "@napi-rs/canvas": "^1.0.8",
    "@openpageflip/core": "0.4.2",
    "@openpageflip/react": "0.7.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "framer-motion": "^12.43.0",
    "howler": "^2.2.4",
    "lucide-react": "^1.28.0",
    "next": "16.4.6",
    "openai": "^7.4.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.3.289",
    "posthog-js": "^1.434.15",
    "raindrop-fx": "github:KingDuane/Raindrop",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-inner-image-zoom": "^4.0.2",
    "recharts": "^3.10.1",
    "tesseract.js": "^7.0.0",
    "three": "^0.185.1",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "husky": "^9.1.7",
    "lint-staged": "17.6.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint"
  },
  "overrides": {
    "minimatch": "11.0.3"
  }
}
